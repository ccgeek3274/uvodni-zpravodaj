{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uvodni-zpravodaj",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "uvodni.sachytynec.cz", "custom_domain": true }
  ]
}
